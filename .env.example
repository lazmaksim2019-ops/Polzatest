# PostgreSQL connection string used by loaders (db/*.ts) and the web app (web/)
# Copy to .env and adjust if needed.
#
# Локальный Docker:
DATABASE_URL=postgres://polza:polza@localhost:5432/polza
#
# Neon (облачный, для деплоя на Vercel):
# DATABASE_URL=postgres://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
