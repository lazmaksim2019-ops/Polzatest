# PostgreSQL connection string for the web app.
# Copy to web/.env and adjust if needed.
#
# Локальный Docker (docker-compose.yml):
DATABASE_URL=postgres://polza:polza@localhost:5432/polza
#
# Для деплоя (Vercel + внешняя БД) — пример для Supabase:
# DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# (managed-провайдеры требуют sslmode=require; Supabase pooled-порт 6543)
